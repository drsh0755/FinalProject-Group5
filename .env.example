# Environment Configuration Template
# Copy this to .env and fill in your values

# Stock Configuration
TARGET_SYMBOL=AAPL
MARKET_INDICES=SPY,QQQ,DIA,^VIX
START_DATE=2018-01-01
END_DATE=2025-12-01

# API Keys (keep secure!)
ALPHA_VANTAGE_KEY=your_api_key_here
NEWSAPI_KEY=your_api_key_here

# Model Configuration
PRICE_HIDDEN_DIM=64
PRICE_NUM_LAYERS=2
FUSION_HIDDEN_DIM=64
DROPOUT=0.2

# Training Configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
NUM_EPOCHS=50
EARLY_STOPPING_PATIENCE=10

# Data Configuration
INPUT_WINDOW=30
FORECAST_HORIZON=1
TRAIN_RATIO=0.7
VAL_RATIO=0.15

# Paths
DATA_DIR=./data
MODELS_DIR=./models/checkpoints
RESULTS_DIR=./results

# Logging
LOG_LEVEL=INFO
LOG_FILE=./results/logs/pipeline.log

# Hardware
USE_GPU=true
GPU_ID=0

# Development
DEBUG=false
VERBOSE=true
