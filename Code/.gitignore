# Data files
data/raw/*
data/processed/*
data/live/*
*.csv
*.json

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/live/.gitkeep

# EXCEPTION: Allow results JSON files (they're small and important)
!results/*.json
!results/**/*.json

# API keys
.env
config.py
*_api_key.txt

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Model checkpoints
*.pth
*.pt
models/checkpoints/*
!models/checkpoints/.gitkeep

# OS
.DS_Store
Thumbs.db

# Logs
*.log
results/logs/*
!results/logs/.gitkeep

# Large data files
*.zip
*.csv.gz
data/raw/news/kaggle*/
data/raw/news/alphavantage_historical_news.csv
data/raw/news/all_alphavantage_news.csv
*.tar.gz
